APP_NAME=PEZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pez.test

# Sitio público y panel de gestión (misma app, distinto host)
APP_DOMAIN=pez.test
ADMIN_DOMAIN=sistema.pez.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Sin punto inicial: la sesión del panel no se comparte con el sitio público
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@pez.com.ar"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_ADDRESS="info@pez.com.ar"

# Numeración inicial (los datos de la empresa y los valores de los
# presupuestos se editan en el panel: Sistema → Configuración)
QUOTES_FIRST_NUMBER=100
WORK_ORDERS_FIRST_NUMBER=1
RECEIPTS_FIRST_NUMBER=1

VITE_APP_NAME="${APP_NAME}"
